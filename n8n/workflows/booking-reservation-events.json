{
  "id": "bkReservationEvt",
  "name": "BOOKING - Reservation Events",
  "nodes": [
    {
      "parameters": {
        "content": "## BOOKING - Reservation Events\nPaste this webhook's production URL into **Admin → Integrations → n8n**.\nSignatures are checked with env `BOOKING_WEBHOOK_SECRET` (the signing secret shown on that page). Duplicate deliveries are ignored.",
        "width": 520,
        "height": 180
      },
      "id": "events-01",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -320
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-events",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "events-02",
      "name": "Platform event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "events-booking-events-post"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst secret = $env.BOOKING_WEBHOOK_SECRET;\nconst raw = item.binary?.data ? (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8') : JSON.stringify(item.json.body);\nconst timestamp = Number(headers['x-booking-timestamp'] || 0);\nlet valid = false;\nif (secret) {\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.${raw}`).digest('hex');\n  const given = String(headers['x-booking-signature'] || '');\n  valid = given.length === expected.length && crypto.timingSafeEqual(Buffer.from(given), Buffer.from(expected));\n}\n// Old deliveries are replays: refuse anything signed more than 10 minutes ago.\nconst fresh = Math.abs(Date.now() / 1000 - timestamp) < 600;\nconst event = JSON.parse(raw);\n// The platform retries until it gets a 2xx; remember recent deliveries so a retry is not acted on twice.\nconst memory = $getWorkflowStaticData('global');\nmemory.seen = memory.seen || [];\nconst duplicate = memory.seen.includes(event.deliveryId);\nif (valid && fresh && !duplicate) {\n  memory.seen.push(event.deliveryId);\n  memory.seen = memory.seen.slice(-500);\n}\nreturn [{ json: { valid: valid && fresh, duplicate, event } }];\n"
      },
      "id": "events-03",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "events-04",
      "name": "Signed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
