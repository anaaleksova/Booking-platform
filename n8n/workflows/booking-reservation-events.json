          },
          "conditions": [
            {
              "leftValue": "={{ !$('Verify signature').first().json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "events-07",
      "name": "New delivery?",
