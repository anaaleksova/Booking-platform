{
  "id": "bkCreateReservat",
  "name": "BOOKING - Create Reservation",
  "nodes": [
    {
      "parameters": {},
      "id": "create-01",
      "name": "When called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BOOKING_API_URL }}/me",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Workflow-Execution-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        }
      },
      "id": "create-02",
      "name": "Who am I",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bkApiCredential1",
          "name": "Booking Platform API"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BOOKING_API_URL }}/businesses/{{ $json.body.businessId }}/reservations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Workflow-Execution-Id",
              "value": "={{ $execution.id }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('When called by another workflow').first().json.idempotencyKey }}"
            },
            {
              "name": "X-Conversation-Id",
              "value": "={{ $('When called by another workflow').first().json.conversationId ?? '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('When called by another workflow').first().json.reservation) }}"
      },
      "id": "create-03",
      "name": "Create reservation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bkApiCredential1",
          "name": "Booking Platform API"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nif (response.statusCode === 200 || response.statusCode === 201) {\n  return [{ json: { ok: true, replayed: response.statusCode === 200, reservation: response.body } }];\n}\nreturn [{ json: {\n  ok: false,\n  status: response.statusCode ?? null,\n  errorCode: response.body?.error || (response.statusCode ? 'TEMPORARY_ERROR' : 'PLATFORM_UNREACHABLE'),\n  message: response.body?.message || 'The booking platform could not be reached.',\n} }];\n"
      },
      "id": "create-04",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "When called by another workflow": {
      "main": [
        [
          {
            "node": "Who am I",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Who am I": {
      "main": [
        [
          {
            "node": "Create reservation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create reservation": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "meta": {
    "description": "Creates a reservation through the platform with an Idempotency-Key, so a retried step cannot book twice. Returns { ok, reservation } or { ok: false, errorCode, message }."
  },
  "tags": []
}
