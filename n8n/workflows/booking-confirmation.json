      "id": "confirmation-03",
      "name": "Get reservation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bkApiCredential1",
          "name": "Booking Platform API"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nif (response.statusCode !== 200) {\n  console.log('Could not load reservation', response.statusCode);\n  return [{ json: { send: false, reason: 'reservation not available' } }];\n}\nconst r = response.body;\n// Message the customer where they talk to the business; TEST identities are only logged.\nconst channel = (r.channels || [])[0];\nif (!channel) return [{ json: { send: false, reason: 'customer has no chat channel', reservationId: r.id } }];\nconst day = new Date(r.date + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });\nconst price = new Intl.NumberFormat('en-GB', { style: 'currency', currency: r.currency }).format(r.finalPrice);\nconst people = r.numberOfParticipants === 1 ? '1 person' : `${r.numberOfParticipants} people`;\n\nif (r.source === channel.provider || (r.source === 'API' && channel.provider === 'TEST')) {\n  return [{ json: { send: false, reason: 'already confirmed in the chat', reservationId: r.id } }];\n}\nconst resources = (r.resources || []).map(x => x.name).join(', ');\nconst text = [\n  'Reservation confirmed!',\n  '',\n  r.serviceName,\n  `${day} at ${r.start}`,\n  people,\n  price,\n  resources ? `With: ${resources}` : null,\n  '',\n  `Reservation #${r.id}`,\n].filter(line => line !== null).join('\\n');\nreturn [{ json: { send: true, provider: channel.provider, recipientId: channel.externalUserId, text } }];\n"
      },
