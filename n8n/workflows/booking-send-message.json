{
  "id": "bkSendMessage000",
  "name": "BOOKING - Send Message",
  "nodes": [
    {
      "parameters": {},
      "id": "send-01",
      "name": "When called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.provider }}",
                    "rightValue": "INSTAGRAM",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "INSTAGRAM"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.provider }}",
                    "rightValue": "FACEBOOK",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "FACEBOOK"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.provider }}",
                    "rightValue": "TEST",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "TEST"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "send-02",
      "name": "Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.META_GRAPH_VERSION || 'v21.0' }}/me/messages",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ recipient: { id: $json.recipientId }, message: { text: String($json.text).slice(0, 1900) } }, $json.tag ? { messaging_type: 'MESSAGE_TAG', tag: $json.tag } : { messaging_type: 'RESPONSE' })) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $json.pageToken }}"
            }
          ]
        }
      },
      "id": "send-03",
      "name": "Send on Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        -120
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.META_GRAPH_VERSION || 'v21.0' }}/me/messages",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ recipient: { id: $json.recipientId }, message: { text: String($json.text).slice(0, 1900) } }, $json.tag ? { messaging_type: 'MESSAGE_TAG', tag: $json.tag } : { messaging_type: 'RESPONSE' })) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $json.pageToken }}"
            }
          ]
        }
      },
      "id": "send-04",
      "name": "Send on Messenger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        60
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst ok = response.statusCode === 200;\nif (!ok) {\n  console.log('Meta send failed', response.statusCode, JSON.stringify(response.body ?? response.error ?? {}));\n}\nreturn [{ json: { sent: ok, status: response.statusCode ?? null, error: ok ? null : (response.body?.error?.message ?? 'send failed') } }];\n"
      },
      "id": "send-05",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        -30
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconsole.log(`[TEST] to ${item.recipientId}: ${item.text}`);\nreturn [{ json: { sent: false, skipped: 'test channel', text: item.text } }];\n"
      },
      "id": "send-06",
      "name": "Test channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        240
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.BOOKING_API_URL }}/platform/channels?businessId={{ $json.businessId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Workflow-Execution-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "send-10",
      "name": "Find Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bkApiCredential1",
          "name": "Booking Platform API"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\n// The message, plus the Page it goes out from. Without a connected Page, Instagram and\n// Messenger messages cannot be sent: they leave by the switch's fallback and are only logged.\nconst message = $('When called by another workflow').first().json;\nconst page = (($input.first().json.body) || [])[0];\nif (!page && message.provider !== 'TEST') {\n  console.log('No connected Facebook Page for business', message.businessId, '- message not sent');\n  return [{ json: { ...message, provider: 'NO_PAGE' } }];\n}\nreturn [{ json: { ...message, pageId: page?.pageId ?? null, pageToken: page?.pageToken ?? null } }];\n"
      },
      "id": "send-11",
      "name": "Prepare send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
