          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "meta": {
    "description": "Sends a text to a customer on Instagram or Facebook Messenger as the business's own connected Page (its token comes from the platform). TEST messages are only logged."
