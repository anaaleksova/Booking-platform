            "index": 0
          }
        ],
        [
          {
            "node": "Test channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send on Instagram": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send on Messenger": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When called by another workflow": {
      "main": [
        [
          {
            "node": "Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "meta": {
    "description": "Sends a text to a customer on Instagram or Facebook Messenger with the page access token from the 'Meta Page Access Token' credential. TEST messages are only logged."
  },
