{
  "id": "bkSendMessage000",
  "name": "BOOKING - Send Message",
  "nodes": [
    {
      "parameters": {},
      "id": "send-01",
      "name": "When called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.provider }}",
                    "rightValue": "INSTAGRAM",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "INSTAGRAM"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.provider }}",
                    "rightValue": "FACEBOOK",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "FACEBOOK"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.provider }}",
                    "rightValue": "TEST",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "TEST"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "send-02",
      "name": "Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.META_GRAPH_VERSION || 'v21.0' }}/me/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ recipient: { id: $json.recipientId }, message: { text: String($json.text).slice(0, 1900) } }, $json.tag ? { messaging_type: 'MESSAGE_TAG', tag: $json.tag } : { messaging_type: 'RESPONSE' })) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "id": "send-03",
      "name": "Send on Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        -120
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "bkMetaPageToken1",
          "name": "Meta Page Access Token"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.META_GRAPH_VERSION || 'v21.0' }}/me/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ recipient: { id: $json.recipientId }, message: { text: String($json.text).slice(0, 1900) } }, $json.tag ? { messaging_type: 'MESSAGE_TAG', tag: $json.tag } : { messaging_type: 'RESPONSE' })) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "id": "send-04",
      "name": "Send on Messenger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        60
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "bkMetaPageToken1",
          "name": "Meta Page Access Token"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst ok = response.statusCode === 200;\nif (!ok) {\n  console.log('Meta send failed', response.statusCode, JSON.stringify(response.body ?? response.error ?? {}));\n}\nreturn [{ json: { sent: ok, status: response.statusCode ?? null, error: ok ? null : (response.body?.error?.message ?? 'send failed') } }];\n"
      },
      "id": "send-05",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        -30
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconsole.log(`[TEST] to ${item.recipientId}: ${item.text}`);\nreturn [{ json: { sent: false, skipped: 'test channel', text: item.text } }];\n"
      },
      "id": "send-06",
      "name": "Test channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        240
      ]
    }
  ],
  "connections": {
    "Channel": {
      "main": [
        [
          {
            "node": "Send on Instagram",
