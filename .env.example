# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
# Change this (e.g. 55432) if a PostgreSQL is already installed locally. On
# Windows both it and the container can bind 5432 without either reporting a
# conflict, and connections then reach the wrong server.
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/booking
DATABASE_USERNAME=booking
DATABASE_PASSWORD=booking

# --- Security --------------------------------------------------------------
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
JWT_EXPIRATION_MINUTES=720

# --- Mail ------------------------------------------------------------------
# Defaults point at the Mailpit container from docker-compose.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@bookingplatform.local
EMAIL_STARTTLS=false

# --- Application -----------------------------------------------------------
FRONTEND_URL=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# --- Platform administration ---------------------------------------------
# Accounts (comma-separated emails) that run the whole platform: they see every
# business and account at /platform. Only this setting grants it.
PLATFORM_ADMIN_EMAILS=

# --- Connect with Facebook ------------------------------------------------
# The platform's Meta app (developers.facebook.com → your app → Settings →
# Basic). Owners sign in with it on Admin → Integrations to connect their Page.
META_APP_ID=
META_APP_SECRET=
# Optional: a "Facebook Login for Business" configuration id. When set, Meta
# takes the permissions from it instead of META_LOGIN_SCOPES.
META_LOGIN_CONFIG_ID=
# Where Meta sends the owner back. Empty = FRONTEND_URL/admin/integrations.
# A Live Meta app accepts only https: locally, run a tunnel to the backend
# (cloudflared tunnel --url http://localhost:8080) and set
# https://<tunnel>/api/public/meta/return — and add that same address under
# Facebook Login for Business → Settings → Valid OAuth Redirect URIs.
META_REDIRECT_URI=
# The https address of the API as Meta's servers reach it: they fetch event
# pictures from it when an event is shared. Empty = the origin of an https
# META_REDIRECT_URI (the same tunnel locally).
META_PUBLIC_BASE_URL=
# Encrypts the Page tokens the platform keeps. Generate once and keep it:
#   openssl rand -base64 32
META_TOKEN_KEY=

# --- The platform's own n8n -------------------------------------------------
# Answers the Instagram/Messenger chats of every business that connected with
# Facebook. n8n's "Booking Platform API" credential holds this token
# ("Bearer <token>"); it acts for any business, so keep it secret.
#   python -c "import secrets;print('bkpf_'+secrets.token_urlsafe(36))"
INTEGRATIONS_PLATFORM_TOKEN=
# Where those businesses' booking events go (n8n's Reservation Events webhook).
INTEGRATIONS_PLATFORM_WEBHOOK_URL=http://localhost:5678/webhook/booking-events
# Signs those deliveries; n8n checks them with BOOKING_WEBHOOK_SECRET (same value).
INTEGRATIONS_PLATFORM_WEBHOOK_SECRET=
