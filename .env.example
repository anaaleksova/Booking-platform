# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
# Change this (e.g. 55432) if a PostgreSQL is already installed locally. On
# Windows both it and the container can bind 5432 without either reporting a
# conflict, and connections then reach the wrong server.
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/booking
DATABASE_USERNAME=booking
DATABASE_PASSWORD=booking

# --- Security --------------------------------------------------------------
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
JWT_EXPIRATION_MINUTES=720

# --- Mail ------------------------------------------------------------------
# Defaults point at the Mailpit container from docker-compose.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@bookingplatform.local
EMAIL_STARTTLS=false

# --- Application -----------------------------------------------------------
FRONTEND_URL=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
